{
  "name": "golden-ratio-fractal-engine",
  "private": true,
  "version": "6.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "deploy:cf": "vite build && wrangler pages deploy dist",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "npx tsx tests/fractal-autotest.ts",
    "test:headless": "npx tsx tests/headless-fractal-test.ts",
    "test:browser": "npx tsx tests/browser-fractal-test.ts",
    "test:browser:headed": "npx tsx tests/browser-fractal-test.ts --headed",
    "test:benchmark": "npx tsx tests/performance-benchmark.ts",
    "test:quality": "npx tsx tests/code-quality-check.ts",
    "test:mapper": "npx tsx tests/fractal-mapper-test.ts",
    "test:shader-math": "npx tsx tests/shader-math-validation-test.ts",
    "test:mobile": "npx tsx tests/mobile-design-audit.ts",
    "test:engine-parity": "npx tsx tests/cross-engine-parity-test.ts",
    "test:unit": "npm run test:mapper && npm run test:shader-math && npm run test:engine-parity",
    "test:all": "npm run test:unit && npm run test && npm run test:headless && npm run test:benchmark && npm run test:quality"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webgpu/types": "^0.1.72",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.129.1"
  }
}
